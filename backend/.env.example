# QuickInsight backend — environment template
#
# Copy to backend/.env and fill in real values. backend/.env is gitignored
# and must NEVER be committed.
#
#   cp backend/.env.example backend/.env
#
# ─────────────────────────────────────────────────────────────────────

# ─── Authentication ──────────────────────────────────────────────────
# Signing key for session tokens. The server refuses to start in
# production without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ─── First admin account ─────────────────────────────────────────────
# Both must be set for an admin to be created. If either is blank, no
# admin is seeded — which is the correct default, because a hard-coded
# admin means every fresh database ships with a known login.
#
# Minimum password length is 12 characters.
#
# Note: an existing admin is never overwritten. Changing ADMIN_PASSWORD
# here does not rotate a password already in the database — use the
# change-password endpoint for that.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ─── Database ────────────────────────────────────────────────────────
# PostgreSQL connection string. The server tries these in order:
# DATABASE_URL, DATABASE_PUBLIC_URL, POSTGRES_URL.
DATABASE_URL=postgresql://user:password@localhost:5432/quickinsight

# ─── AI provider ─────────────────────────────────────────────────────
# OpenRouter key used server-side to reach the language model. This stays
# on the server: the browser never sees it, and AI requests are proxied
# through this backend precisely so it cannot leak into the bundle.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Column meanings are checked against the web at upload (names and metadata
# only). Set to off to disable; LLM_WEB_CHECK_DAILY_LIMIT caps checks per user per day.
LLM_WEB_SEARCH=on
LLM_WEB_CHECK_DAILY_LIMIT=40

# Authenticated admin benchmark calls are audited but have no daily application
# quota. OpenRouter account/provider budgets still apply.
ADMIN_BENCHMARK_LLM_RATE_LIMIT=90

# ─── Server ──────────────────────────────────────────────────────────
PORT=5002

# Origin allowed by CORS, e.g. https://quickinsight.co.uk
FRONTEND_URL=http://localhost:5173

# Set to "production" on a deployed server. This makes the missing-
# JWT_SECRET check fatal rather than a warning.
NODE_ENV=development

# Account emails (password reset). Without these, reset emails are not sent
# (outside production they are printed to the log instead).
RESEND_API_KEY=
MAIL_FROM=QuickInsight <no-reply@quickinsight.co.uk>
# Where links in emails point.
APP_URL=https://quickinsight.co.uk
