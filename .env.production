# Production build values for the frontend.
#
# THIS FILE IS COMMITTED TO GIT. Put PUBLIC values only.
#
# Everything prefixed VITE_ is compiled into the JavaScript bundle and is
# readable by anyone who opens the site, so a secret placed here would be
# exposed twice over — once in the repository and once in every browser.
# API keys belong in backend/.env, which is gitignored.
VITE_API_URL=https://api.quickinsight.co.uk/api
