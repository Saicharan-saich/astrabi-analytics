# QuickInsight frontend — environment template
#
# Copy to .env and fill in real values. .env is gitignored and must NEVER
# be committed.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────
# IMPORTANT — anything prefixed VITE_ is compiled into the JavaScript
# bundle and is readable by anyone who opens the site. Put ONLY public
# values here. Never an API key, never a database URL, never a secret.
#
# API keys for the language model live in backend/.env and are used
# server-side only. The browser reaches the model through this app's own
# backend, which exists partly so that key never ships to a client.
# ─────────────────────────────────────────────────────────────────────

# Base URL of the QuickInsight backend API.
VITE_API_URL=http://localhost:5002/api

# Backend origin without the /api suffix, used by the live query engine.
VITE_BACKEND_URL=http://localhost:5002

# Live refresh service endpoint. Public URL only.
VITE_API_BASE_URL=https://api.quickinsight.co.uk
